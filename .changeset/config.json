{
  "changelog": [
    "@changesets/changelog-github",
    { "repo": "papra-hq/papra", "template": "\n\n- {summary} - {pull} {commit} by {authors}" }
  ],
  "commit": false,
  "fixed": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "@papra/app-client",
    "@papra/app-server",
    "@papra/docs",
    "@papra/search-parser-demo",
    "@papra/website"
  ],
  "privatePackages": {
    "tag": true,
    "version": true
  }
}
